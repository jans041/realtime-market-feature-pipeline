# Copy to .env and fill in. .env is gitignored.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_TOPIC_RAW=market.trades.raw
KAFKA_TOPIC_DLQ=market.trades.dlq

# Phase 1 producer source: Coinbase Advanced Trade (public market data, no API key)
MARKET_WS_URL=wss://advanced-trade-ws.coinbase.com
MARKET_PRODUCT_IDS=BTC-USD,ETH-USD
INCLUDE_SNAPSHOTS=false

# Phase 3: S3-compatible object storage (SeaweedFS) + Iceberg REST catalog.
# Credentials for the LOCAL dev stack only; never put real cloud keys here.
S3_ACCESS_KEY=rtfp-dev
S3_SECRET_KEY=change-me-to-a-random-string
S3_ENDPOINT=http://localhost:8333
AWS_REGION=us-east-1
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse/
